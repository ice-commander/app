<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- libadwaita 1.10's light window background: what Android shows before GTK's first frame. -->
    <style name="Theme.IceCommander" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/adw_window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/adw_window_bg</item>
        <!-- The bars take the window's colour, so a dark application does not sit in a white
             frame. Android 15 and up ignore these and have the app draw behind the bars
             instead; harmless there, and they are what works below it. -->
        <item name="android:navigationBarColor">@color/adw_window_bg</item>
        <item name="android:statusBarColor">@color/adw_window_bg</item>
        <item name="android:windowLightNavigationBar">@bool/adw_light_bars</item>
        <item name="android:windowLightStatusBar">@bool/adw_light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>

{
  "schema": 1,
  "kind": "sftp",
  "label": { "literal": "SFTP" },
  "icon": "asset:ic-sftp-fs/sftp.svg",
  "identity": "name",
  "opens_at": "remote_path",
  "summary": { "fmt": "{user}@{host}", "fallback": { "fmt": "{host}" } },

  "fields": [
    { "bind": "name", "type": "text", "scope": "record", "required": true },
    { "bind": "folder", "type": "text", "scope": "record", "empty_as_absent": true },
    { "bind": "host", "type": "text", "required": true, "empty_as_absent": true },
    { "bind": "port", "type": "integer", "min": 1, "max": 65535,
      "default": 22, "derive": "commit_only", "on_parse_error": "default" },
    { "bind": "user", "type": "text", "required": true, "empty_as_absent": true },
    { "bind": "auth_type", "type": "text", "default": "password", "derive": "commit_only" },
    { "bind": "pass", "type": "text", "secret": true, "empty_as_absent": true,
      "when": { "ne": ["state.auth_type", "key"] } },
    { "bind": "key_path", "type": "path", "empty_as_absent": true,
      "when": { "eq": ["state.auth_type", "key"] } },
    { "bind": "passphrase", "type": "text", "secret": true, "empty_as_absent": true,
      "when": { "eq": ["state.auth_type", "key"] } },
    { "bind": "remote_path", "type": "path", "empty_as_absent": true },

    { "bind": "use_tunnel", "type": "bool" },
    { "bind": "tunnel_host", "type": "text", "empty_as_absent": true,
      "when": { "truthy": "state.use_tunnel" } },
    { "bind": "tunnel_port", "type": "integer", "min": 1, "max": 65535,
      "default": 22, "derive": "commit_only", "on_parse_error": "default",
      "when": { "truthy": "state.use_tunnel" } },
    { "bind": "tunnel_user", "type": "text", "empty_as_absent": true,
      "when": { "truthy": "state.use_tunnel" } },
    { "bind": "tunnel_auth_type", "type": "text", "default": "password", "derive": "commit_only",
      "when": { "truthy": "state.use_tunnel" } },
    { "bind": "tunnel_pass", "type": "text", "secret": true, "empty_as_absent": true,
      "when": { "all": [ { "truthy": "state.use_tunnel" },
                         { "ne": ["state.tunnel_auth_type", "key"] } ] } },
    { "bind": "tunnel_key_path", "type": "path", "empty_as_absent": true,
      "when": { "all": [ { "truthy": "state.use_tunnel" },
                         { "eq": ["state.tunnel_auth_type", "key"] } ] } },
    { "bind": "tunnel_passphrase", "type": "text", "secret": true, "empty_as_absent": true,
      "when": { "all": [ { "truthy": "state.use_tunnel" },
                         { "eq": ["state.tunnel_auth_type", "key"] } ] } }
  ],

  "form": {
    "t": "view",
    "surface": "embedded",
    "scroll": "vertical",
    "spacing": 8,
    "sensitive": { "ne": ["view.mode", "view"] },
    "children": [
      { "t": "input", "id": "name", "bind": "name", "chrome": "bare",
        "placeholder": { "tr": "conn_manager.conn_name_placeholder", "en": "Connection Name (e.g. My FTP Server)" } },

      { "t": "group", "id": "auth_group", "children": [
        { "t": "choice", "id": "auth_type", "bind": "auth_type", "chrome": "row",
          "title": { "tr": "conn_manager.auth_type", "en": "Authentication Type" },
          "options": [
            { "value": "password", "label": { "tr": "conn_manager.auth_password", "en": "Password" } },
            { "value": "key", "label": { "tr": "conn_manager.auth_ssh_key", "en": "SSH Private Key" } } ],
          "decode": { "case_insensitive": true, "unknown": "password" } } ] },

      { "t": "row", "id": "address", "spacing": 8, "children": [
        { "t": "input", "id": "host", "bind": "host", "chrome": "bare", "weight": 1,
          "placeholder": { "tr": "conn_manager.host_sftp_placeholder", "en": "Host (e.g. sftp.example.com)" } },
        { "t": "input", "id": "port", "bind": "port", "chrome": "bare", "width": 100,
          "variant": "integer",
          "placeholder": { "tr": "conn_manager.port_placeholder", "en": "Port (default: 21 / 22)" } } ] },

      { "t": "row", "id": "credentials", "spacing": 8, "children": [
        { "t": "input", "id": "user", "bind": "user", "chrome": "bare", "weight": 1,
          "placeholder": { "tr": "conn_manager.username_placeholder", "en": "Username" } },
        { "t": "input", "id": "pass", "bind": "pass", "chrome": "bare", "weight": 1,
          "variant": "masked",
          "visible": { "ne": ["state.auth_type", "key"] },
          "placeholder": { "tr": "conn_manager.password_placeholder", "en": "Password" } } ] },

      { "t": "input", "id": "key_path", "bind": "key_path", "chrome": "bare",
        "variant": "path",
        "visible": { "eq": ["state.auth_type", "key"] },
        "picker": { "mode": "file", "title": { "tr": "conn_manager.select_ssh_key", "en": "Select SSH Private Key" } },
        "placeholder": { "tr": "conn_manager.key_path_placeholder", "en": "SSH Private Key Path (e.g. ~/.ssh/id_rsa)" } },

      { "t": "input", "id": "passphrase", "bind": "passphrase", "chrome": "bare",
        "variant": "masked",
        "visible": { "eq": ["state.auth_type", "key"] },
        "placeholder": { "tr": "conn_manager.passphrase_placeholder", "en": "SSH Private Key Passphrase (optional)" } },

      { "t": "input", "id": "remote_path", "bind": "remote_path", "chrome": "bare",
        "placeholder": { "tr": "conn_manager.remote_path_placeholder", "en": "Remote Path (e.g. /var/www or /home/user/files)" } },

      { "t": "group", "id": "tunnel_toggle_group", "children": [
        { "t": "switch", "id": "use_tunnel", "bind": "use_tunnel", "chrome": "row",
          "title": { "tr": "conn_manager.use_tunnel", "en": "Use SSH Tunnel" } } ] },

      { "t": "separator", "id": "tunnel_rule",
        "visible": { "truthy": "state.use_tunnel" } },

      { "t": "column", "id": "tunnel_box", "spacing": 8,
        "visible": { "truthy": "state.use_tunnel" },
        "children": [
          { "t": "group", "id": "tunnel_auth_group", "children": [
            { "t": "choice", "id": "tunnel_auth_type", "bind": "tunnel_auth_type", "chrome": "row",
              "title": { "tr": "conn_manager.tunnel_auth_type", "en": "Tunnel Auth Type" },
              "options": [
                { "value": "password", "label": { "tr": "conn_manager.auth_password", "en": "Password" } },
                { "value": "key", "label": { "tr": "conn_manager.auth_ssh_key", "en": "SSH Private Key" } } ],
              "decode": { "case_insensitive": true, "unknown": "password" } } ] },

          { "t": "row", "id": "tunnel_address", "spacing": 8, "children": [
            { "t": "input", "id": "tunnel_host", "bind": "tunnel_host", "chrome": "bare", "weight": 1,
              "placeholder": { "tr": "conn_manager.tunnel_host_placeholder", "en": "Tunnel Host" } },
            { "t": "input", "id": "tunnel_port", "bind": "tunnel_port", "chrome": "bare", "width": 100,
              "variant": "integer",
              "placeholder": { "tr": "conn_manager.tunnel_port_placeholder", "en": "Tunnel Port (default: 22)" } } ] },

          { "t": "input", "id": "tunnel_user", "bind": "tunnel_user", "chrome": "bare",
            "placeholder": { "tr": "conn_manager.tunnel_user_placeholder", "en": "Tunnel Username" } },

          { "t": "input", "id": "tunnel_pass", "bind": "tunnel_pass", "chrome": "bare",
            "variant": "masked",
            "visible": { "ne": ["state.tunnel_auth_type", "key"] },
            "placeholder": { "tr": "conn_manager.tunnel_password_placeholder", "en": "Tunnel Password" } },

          { "t": "input", "id": "tunnel_key_path", "bind": "tunnel_key_path", "chrome": "bare",
            "variant": "path",
            "visible": { "eq": ["state.tunnel_auth_type", "key"] },
            "picker": { "mode": "file", "title": { "tr": "conn_manager.select_tunnel_ssh_key", "en": "Select Tunnel SSH Private Key" } },
            "placeholder": { "tr": "conn_manager.tunnel_key_path_placeholder", "en": "Tunnel SSH Key Path (e.g. ~/.ssh/id_rsa)" } },

          { "t": "input", "id": "tunnel_passphrase", "bind": "tunnel_passphrase", "chrome": "bare",
            "variant": "masked",
            "visible": { "eq": ["state.tunnel_auth_type", "key"] },
            "placeholder": { "tr": "conn_manager.tunnel_passphrase_placeholder", "en": "Tunnel SSH Key Passphrase (optional)" } } ] }
    ]
  }
}
